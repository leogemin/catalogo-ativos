# Copie para .env e ajuste. Os valores de DB_* batem com o docker-compose.yml da raiz.
PORT=3000
API_PREFIX=api
# Origens liberadas no CORS, separadas por vírgula (* libera todas).
CORS_ORIGINS=http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_USER=catalogo
DB_PASSWORD=catalogo
DB_NAME=catalogo_ativos
DB_SSL=false
DB_LOGGING=false
# true = aplica migrations pendentes ao subir a API.
DB_MIGRATIONS_RUN=false

CSV_MAX_FILE_SIZE_MB=5

# Segredo dos tokens JWT (mínimo 32 caracteres). Gere um com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-longo
# Validade do token em segundos (28800 = 8 h).
JWT_EXPIRES_IN=28800
# Senha inicial do usuário "admin" (mín. 8 caracteres). Usada só para criá-lo
# na primeira subida da API; depois disso pode ser removida daqui.
ADMIN_PASSWORD=admin12345
